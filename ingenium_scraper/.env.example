# Copia este archivo a .env (nunca lo subas a git)
# Clave de Google AI Studio (Gemini)
LLM_API_KEY=
# Modelo para la extracción semántica (Fase 3)
LLM_MODEL=gemini-2.5-flash
# Peticiones simultáneas a la API
LLM_CONCURRENCY=4
# Opcional: contacto que se envía en el User-Agent del scraper (vacío = ninguno)
SCRAPER_CONTACT=
