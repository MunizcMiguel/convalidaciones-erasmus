    {
      "text": "Students can calculate limits and perform some basic proofs on limits and continuity.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can calculate derivatives and use them in applications such as calculating rates of change and finding extreme values.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can graph functions by finding the intervals where the functions are increasing, decreasing, concave up or down, and their asymptotes.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can effectively use transcendental functions including logarithmic, exponential, and inverse trigonometric functions.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can calculate integrals using the definition of Riemann sums and use this to find approximate values.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can utilize various techniques to calculate integrals and improper integrals.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can use integration to calculate area, volume, arc length, and surface area.",
      "type": "skill",
      "code": null
    },
    {
      "text": "Students can parameterize and use plane curves using Cartesian and polar coordinates.",
      "type": "skill",
      "code": null
    }
