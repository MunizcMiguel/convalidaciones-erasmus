  "learning_outcomes": [
    {
      "text": "Address theoretical metallurgy with the basics of crystallography, the study of crystalline defects, phase diagrams, rapid transformations and their application to the metallurgy of ferrous alloys.",
      "type": "unspecified",
      "code": null
    },
    {
      "text": "Focus on microstructure and its formation to explain the different physical properties obtained, particularly the mechanical properties of metals and their alloys.",
      "type": "unspecified",
      "code": null
    },
    {
      "text": "Be introduced to composite materials and their processing methods, particularly long-fiber and polymer-matrix composites.",
      "type": "unspecified",
      "code": null
    },
    {
      "text": "Understand Liquid Composite Molding (LCM) processes and the modeling aspect of impregnating a fibrous medium with resin to approach RTM (Resin Transfer Molding) process simulation using an analytical approach.",
      "type": "unspecified",
      "code": null
    }
  ],
  "syllabus_topics": [
    "Metallic Materials",
    "Theoretical metallurgy",
    "Crystallography basics",
    "Crystalline defects",
    "Phase diagrams",
    "Rapid transformations",
    "Application to ferrous alloy metallurgy",
    "Microstructure and its formation",
    "Physical properties (especially mechanical) of metals and alloys",
    "Composite Materials",
    "Introduction to composite materials and processing methods",
    "Long-fiber composites",
    "Polymer-matrix composites",
    "Liquid Composite Molding (LCM) processes",
    "Modeling of fibrous medium impregnation by resin",
    "Resin Transfer Molding (RTM) process simulation (analytical approach)"
  ],
